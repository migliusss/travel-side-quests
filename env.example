# Copy to .env and fill in: cp env.example .env
# .env is gitignored. Never commit real values.

# Postgres — both the container compose.yaml starts and the URL the app connects with.
POSTGRES_DB=travel_side_quests
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=jdbc:postgresql://localhost:5432/travel_side_quests

# The single moderation account guarding /api/v1/admin/**.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Where the frontend is served from, for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Uploads allowed per IP address per hour.
UPLOAD_MAX_PER_HOUR=20
